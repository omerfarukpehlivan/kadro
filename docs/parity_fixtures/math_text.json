  "figureSvg": {
    "$comment": "questions.figure_svg ve konu anlatımı 'figure' bloğu için güvenlik kuralı. İstemciler bu kurala uymayan SVG'yi göstermez (DB'de de CHECK kısıtı vardır).",
    "maxLength": 60000,
    "allowedTags": ["svg", "g", "path", "line", "polyline", "polygon", "circle", "rect", "text"],
    "allowedAttributes": [
      "xmlns", "viewBox", "width", "height", "fill", "stroke", "stroke-width", "stroke-dasharray",
