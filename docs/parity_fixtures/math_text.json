{
  "$comment": "TASK-172 — Matematik gösterimi ortak sözleşmesi. Mobil (lib/core/utils/math_text.dart) ve Web (src/domain/math-text.ts) bu dosyaya karşı test edilir. 'cleanCases': soru metni temizleyicisi; 'segmentCases': metni yazı/matematik parçalarına bölen ayrıştırıcı; 'latexCommands': içerikte izin verilen LaTeX komutları (iki platformda da render testi yapılır).",
  "rules": {
    "inlineMath": "$...$ (tek satır, boş olamaz)",
    "displayMath": "$$...$$ (ayrı satırda ortalanır)",
    "literalDollar": "\\$",
    "unmatchedDollar": "düz yazı olarak kalır",
    "escapedNewline": "Kaçışlı \\n yalnızca matematik dışındaki yazıda satır sonuna çevrilir",
    "idempotent": "Temizlenmiş metin yeniden temizlendiğinde değişmez (her cleanCases örneği için test edilir)",
    "legacyArrowMath": "$ → $, $\\rightarrow$ gibi yalnızca ok içeren matematik parçaları düz oka (→ / ←) çevrilir",
    "cleanupScope": "Markdown, ok ve tırnak temizlikleri yalnızca yazı parçalarına uygulanır; matematik parçaları olduğu gibi korunur"
  },
  "cleanCases": [
    { "description": "Matematiksiz düz metin değişmez", "input": "Aşağıdakilerden hangisi doğrudur?", "expected": "Aşağıdakilerden hangisi doğrudur?" },
    { "description": "Satır içi matematik korunur", "input": "$\\sqrt{75} + \\sqrt[3]{8}$ işleminin sonucu kaçtır?", "expected": "$\\sqrt{75} + \\sqrt[3]{8}$ işleminin sonucu kaçtır?" },
    { "description": "Eşitsizlikteki <- matematik içinde bozulmaz", "input": "$x<-1$ ve $y->2$ olduğuna göre", "expected": "$x<-1$ ve $y->2$ olduğuna göre" },
    { "description": "Matematik dışındaki -> oka çevrilir", "input": "Oğuş -> Urug", "expected": "Oğuş → Urug" },
    { "description": "Eski içerikteki yalnızca ok içeren matematik parçası düz oka çevrilir", "input": "Oğuş $ → $ Urug $\\rightarrow$ Boy", "expected": "Oğuş → Urug → Boy" },
    { "description": "Markdown kalınlık yalnızca yazıda temizlenir", "input": "**Buna göre** $a \\cdot b$ kaçtır?", "expected": "Buna göre $a \\cdot b$ kaçtır?" },
    { "description": "Kaçışlı satır sonu gerçek satır sonuna çevrilir", "input": "I. $x>0$\\nII. $y<0$", "expected": "I. $x>0$\nII. $y<0$" },
    { "description": "Matematikteki \\neq, \\notin komutları satır sonu sanılmaz", "input": "Satır\\n$a \\neq b$ ve $x \\notin A$", "expected": "Satır\n$a \\neq b$ ve $x \\notin A$" },
    { "description": "Temizlik iki kez uygulansa da sonuç değişmez", "input": "I. $x \\ne 0$\n**II.** a -> b", "expected": "I. $x \\ne 0$\nII. a → b" },
    { "description": "Kaçışlı dolar korunur", "input": "Fiyatı 5 \\$ olan ürün", "expected": "Fiyatı 5 \\$ olan ürün" },
    { "description": "Fazla boşluklar yazıda sadeleşir", "input": "A  ve   B   kümeleri", "expected": "A ve B kümeleri" },
    { "description": "Ayrık matematik bloğu korunur", "input": "Buna göre\\n$$\\frac{a+b}{2}$$\\nkaçtır?", "expected": "Buna göre\n$$\\frac{a+b}{2}$$\nkaçtır?" }
  ],
  "segmentCases": [
    { "description": "Matematiksiz metin tek yazı parçasıdır", "input": "Düz metin", "expected": [{ "type": "text", "value": "Düz metin" }] },
    { "description": "Satır içi matematik", "input": "Sonuç $x^2$ olur.", "expected": [{ "type": "text", "value": "Sonuç " }, { "type": "math", "value": "x^2", "display": false }, { "type": "text", "value": " olur." }] },
    { "description": "Yalnızca matematik", "input": "$\\frac{1}{2}$", "expected": [{ "type": "math", "value": "\\frac{1}{2}", "display": false }] },
    { "description": "Ayrık matematik", "input": "a $$\\sqrt{2}$$ b", "expected": [{ "type": "text", "value": "a " }, { "type": "math", "value": "\\sqrt{2}", "display": true }, { "type": "text", "value": " b" }] },
    { "description": "Kaçışlı dolar yazı olarak kalır", "input": "5 \\$ ve $y$", "expected": [{ "type": "text", "value": "5 $ ve " }, { "type": "math", "value": "y", "display": false }] },
    { "description": "Kapanmayan dolar yazıdır", "input": "Fiyat $5", "expected": [{ "type": "text", "value": "Fiyat $5" }] },
    { "description": "Boş matematik yazıdır", "input": "a $$ b", "expected": [{ "type": "text", "value": "a $$ b" }] },
    { "description": "Satır sonu içeren matematik yazı sayılır", "input": "$a\nb$", "expected": [{ "type": "text", "value": "$a\nb$" }] },
    { "description": "Art arda iki matematik", "input": "$a$$b$", "expected": [{ "type": "math", "value": "a", "display": false }, { "type": "math", "value": "b", "display": false }] }
  ],
  "latexCommands": [
    "frac", "dfrac", "tfrac", "sqrt", "cdot", "times", "div", "pm", "mp",
