      "font-style", "text-anchor", "transform"
    ],
    "forbiddenPatterns": ["<!", "<?", "javascript:", "data:", "&#", "url("],
    "cases": [
      { "description": "Üreticinin çıktısı gibi sade SVG güvenlidir", "svg": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 10 10\" width=\"10\" height=\"10\" fill=\"none\" stroke=\"currentColor\"><g transform=\"translate(2 2)\"><circle cx=\"5\" cy=\"5\" r=\"2\"/><text x=\"1\" y=\"9\" fill=\"currentColor\" text-anchor=\"middle\">A &amp; B</text></g></svg>", "safe": true },
