# Kadro KPSS Release Keystore Yapılandırma Şablonu
# Bu dosyayı 'key.properties' olarak kopyalayıp kendi keystore bilgilerinizi giriniz.
# Örnek Keystore Oluşturma Komutu:
# keytool -genkeypair -v -keystore android/app/upload-keystore.jks -alias upload -keyalg RSA -keysize 2048 -validity 10000

storePassword=<keystore-sifren>
keyPassword=<anahtar-sifren>
keyAlias=upload
storeFile=upload-keystore.jks
